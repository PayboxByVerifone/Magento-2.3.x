<!-- Payment Method Facade configuration -->
<virtualType name="PbxepwalletFacade" type="Magento\Payment\Model\Method\Adapter">
    <arguments>
        <argument name="code" xsi:type="const">\Paybox\Epayment\Model\Ui\PbxepwalletConfigProvider::CODE</argument>
        <argument name="formBlockType" xsi:type="string">Paybox\Epayment\Block\Checkout\Payment</argument>
        <argument name="infoBlockType" xsi:type="string">Paybox\Epayment\Block\Info</argument>
        <argument name="valueHandlerPool" xsi:type="object">PbxepwalletValueHandlerPool</argument>
        <argument name="commandPool" xsi:type="object">PbxepwalletCommandPool</argument>
    </arguments>
</virtualType>

<!-- Configuration reader -->
<virtualType name="PbxepwalletConfig" type="Magento\Payment\Gateway\Config\Config">
    <arguments>
        <argument name="methodCode" xsi:type="const">\Paybox\Epayment\Model\Ui\PbxepwalletConfigProvider::CODE</argument>
    </arguments>
</virtualType>

<!-- Logger, initialized with PbxepwalletConfig -->
<virtualType name="PbxepwalletLogger" type="Magento\Payment\Model\Method\Logger">
    <arguments>
        <argument name="config" xsi:type="object">PbxepwalletConfig</argument>
    </arguments>
</virtualType>

<type name="Paybox\Epayment\Gateway\Http\Client\ClientMock">
    <arguments>
        <argument name="logger" xsi:type="object">PbxepwalletLogger</argument>
    </arguments>
</type>

<!-- Commands infrastructure -->
<virtualType name="PbxepwalletCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
    <arguments>
        <argument name="commands" xsi:type="array">
            <item name="authorize" xsi:type="string">PbxepwalletAuthorizeCommand</item>
            <item name="capture" xsi:type="string">PbxepwalletCaptureCommand</item>
            <item name="void" xsi:type="string">PbxepwalletVoidCommand</item>
        </argument>
    </arguments>
</virtualType>

<!-- Authorize command -->
<virtualType name="PbxepwalletAuthorizeCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
    <arguments>
        <argument name="requestBuilder" xsi:type="object">PbxepwalletAuthorizationRequest</argument>
        <argument name="handler" xsi:type="object">PbxepwalletResponseHandlerComposite</argument>
        <argument name="transferFactory" xsi:type="object">Paybox\Epayment\Gateway\Http\TransferFactory</argument>
        <argument name="client" xsi:type="object">Paybox\Epayment\Gateway\Http\Client\ClientMock</argument>
    </arguments>
</virtualType>

<!-- Authorization Request -->
<virtualType name="PbxepwalletAuthorizationRequest" type="Magento\Payment\Gateway\Request\BuilderComposite">
    <arguments>
        <argument name="builders" xsi:type="array">
            <item name="transaction" xsi:type="string">Paybox\Epayment\Gateway\Request\AuthorizationRequest</item>
            <item name="mockData" xsi:type="string">Paybox\Epayment\Gateway\Request\MockDataRequest</item>
        </argument>
    </arguments>
</virtualType>
<type name="Paybox\Epayment\Gateway\Request\AuthorizationRequest">
    <arguments>
        <argument name="config" xsi:type="object">PbxepwalletConfig</argument>
    </arguments>
</type>

<!-- Capture command -->
<virtualType name="PbxepwalletCaptureCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
    <arguments>
        <argument name="requestBuilder" xsi:type="object">Paybox\Epayment\Gateway\Request\CaptureRequest</argument>
        <argument name="handler" xsi:type="object">Paybox\Epayment\Gateway\Response\TxnIdHandler</argument>
        <argument name="transferFactory" xsi:type="object">Paybox\Epayment\Gateway\Http\TransferFactory</argument>
        <argument name="validator" xsi:type="object">Paybox\Epayment\Gateway\Validator\ResponseCodeValidator</argument>
        <argument name="client" xsi:type="object">Paybox\Epayment\Gateway\Http\Client\ClientMock</argument>
    </arguments>
</virtualType>

<!-- Capture Request -->
<type name="Paybox\Epayment\Gateway\Request\CaptureRequest">
    <arguments>
        <argument name="config" xsi:type="object">PbxepwalletConfig</argument>
    </arguments>
</type>

<!-- Void command -->
<virtualType name="PbxepwalletVoidCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
    <arguments>
        <argument name="requestBuilder" xsi:type="object">Paybox\Epayment\Gateway\Request\VoidRequest</argument>
        <argument name="handler" xsi:type="object">Paybox\Epayment\Gateway\Response\TxnIdHandler</argument>
        <argument name="transferFactory" xsi:type="object">Paybox\Epayment\Gateway\Http\TransferFactory</argument>
        <argument name="validator" xsi:type="object">Paybox\Epayment\Gateway\Validator\ResponseCodeValidator</argument>
        <argument name="client" xsi:type="object">Paybox\Epayment\Gateway\Http\Client\ClientMock</argument>
    </arguments>
</virtualType>

<!-- Void Request -->
<type name="Paybox\Epayment\Gateway\Request\VoidRequest">
    <arguments>
        <argument name="config" xsi:type="object">PbxepwalletConfig</argument>
    </arguments>
</type>

<!-- Response handlers -->
<virtualType name="PbxepwalletResponseHandlerComposite" type="Magento\Payment\Gateway\Response\HandlerChain">
    <arguments>
        <argument name="handlers" xsi:type="array">
            <item name="txnid" xsi:type="string">Paybox\Epayment\Gateway\Response\TxnIdHandler</item>
            <item name="fraud" xsi:type="string">Paybox\Epayment\Gateway\Response\FraudHandler</item>
        </argument>
    </arguments>
</virtualType>

<!-- Value handlers infrastructure -->
<virtualType name="PbxepwalletValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
    <arguments>
        <argument name="handlers" xsi:type="array">
            <item name="default" xsi:type="string">PbxepwalletConfigValueHandler</item>
        </argument>
    </arguments>
</virtualType>
<virtualType name="PbxepwalletConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
    <arguments>
        <argument name="configInterface" xsi:type="object">PbxepwalletConfig</argument>
    </arguments>
</virtualType>

<type name="Paybox\Epayment\Block\Info">
    <arguments>
        <argument name="config" xsi:type="object">PbxepwalletConfig</argument>
    </arguments>
</type>